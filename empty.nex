#NEXUS

begin data;
	dimensions ntax=5 nchar=15;
	format transpose;
	format symbols="0123";
	taxlabels	 		bono	meren	geve	hitrom	guya;
	matrix		
		fish			
		cat				
		one				
		two				
		you				
		they			
		sits			
		eats			
		loves			
		axe				
		house			
		big				
		short			
		impf			
		pl				
	;
end;

begin assumptions;
	ANCSTATES anc = 
		0: 1-15;
end;

begin paup;
	assume ancStates=anc;
end;